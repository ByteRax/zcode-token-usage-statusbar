{
  "description": "zcode-token-usage-statusbar: 会话启动时同步运行时文件;未注入时自动安装/修复悬浮状态条(始终开启,会修改 app.asar,成功后需完全退出并重开;不想安装用 /uninstall-overlay 写豁免标记,仍会阻止重注入与提示);自动安装失败时给出故障提示,用 /install-overlay 兜底;待重启/待更新由状态条齿轮红点提醒,不再注入会话文字;每次提问记录时刻并注入上一轮速率背景行(回答末尾统计行由前端确定性渲染,依赖 renderer 桥,--current 守卫防止拿上一轮数据充数);hook 解释器按 python3→python→py -3 自动回退(Windows 无 python3 别名)",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "shell": true,
            "command": "python3 \"${ZCODE_PLUGIN_ROOT}/hooks/session-start.py\" || python \"${ZCODE_PLUGIN_ROOT}/hooks/session-start.py\" || py -3 \"${ZCODE_PLUGIN_ROOT}/hooks/session-start.py\"",
            "timeoutMs": 60000,
            "statusMessage": "zcode-token-usage-statusbar: 检查悬浮状态条…"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": true,
            "command": "python3 \"${ZCODE_PLUGIN_ROOT}/hooks/prompt-submit.py\" || python \"${ZCODE_PLUGIN_ROOT}/hooks/prompt-submit.py\" || py -3 \"${ZCODE_PLUGIN_ROOT}/hooks/prompt-submit.py\"",
            "timeoutMs": 8000,
            "statusMessage": "zcode-token-usage-statusbar: 记录提问时刻…"
          }
        ]
      }
    ]
  }
}
