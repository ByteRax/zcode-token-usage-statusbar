    },
    {
      "id": "inspect-target",
      "phase": "research",
      "mode": "read",
      "depends_on": [],
      "writes": [],
      "objective": "Identify target integration points",
      "acceptance": "Paths, reusable APIs, baseline risks"
    },
    {
      "id": "contract",
      "phase": "integrate",
      "mode": "read",
      "depends_on": ["research-reference", "inspect-target"],
      "writes": [],
